<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HarmOsWin.HdcBridge</RootNamespace>
    <AssemblyName>HarmOsWin.HdcBridge</AssemblyName>
    <!-- 控制台子系统：不加载任何 WPF 依赖，hdc 子进程环境与手工命令行一致 -->
    <UseWPF>false</UseWPF>
  </PropertyGroup>

</Project>